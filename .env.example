# Copy to .env and change the passwords. docker compose reads .env automatically.
# If you already have a database volume, keep the password it was created with
# (or reset it with `docker compose down -v`, which deletes the data).

# Postgres (holds both the market data and Airflow's own tables)
POSTGRES_USER=quant_user
POSTGRES_PASSWORD=quant_password
POSTGRES_DB=ir_market_data

# Airflow web UI login (http://localhost:8081)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=change-me
